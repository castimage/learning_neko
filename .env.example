# 应用基础信息
APP_NAME=learning-neko
APP_HOST=127.0.0.1
APP_PORT=8000

# 热重载，生产禁止开启，仅限开发时使用
APP_RELOAD=false

# 日志等级
APP_LOG_LEVEL=DEBUG

# 是否格式化日志为json
APP_LOG_JSON=false

# 数据库存储位置
APP_DATA_DIR=./data

# 数据库名称
DB_FILENAME=learning-neko.db

# 是否回显sqlalchemy生成的sql语句
DB_ECHO=false

# 启动时是否建表
DB_CREATE_ALL_ON_STARTUP=true

# 获取数据库连接的等待超时（秒）。并发写入时 sqlite 会串行化，等待超过该值才报错。
DB_CONNECT_TIMEOUT_SECONDS=15

# 启用的供应商
LLM_ACTIVE_PROVIDER=deepseek

# 备用供应商列表
LLM_FAILOVER_PROVIDERS=[]

# 要自定义url与模型的时候取消注释，留空则沿用供应商profile的内置地址
# llm_BASE_URL=https://example.com/v1
# llm_MODEL=claude-Fable-5


# 模型相关配置

# 模型温度
LLM_TEMPERATURE=0.3

# 模型超时时间
LLM_TIMEOUT_SECONDS=120

# 最大模型失败重试次数
LLM_MAX_ATTEMPTS=3

# 指数退避基数
LLM_BACKOFF_SECONDS=1.0

# 单次补全最大token数量
LLM_MAX_TOKENS=4096

# 返回信息解析失败带错误信息重试次数
LLM_STRUCTURED_REPAIR_ATTEMPTS=1


# 素材库目录名，位于 APP_DATA_DIR 下
ASSET_DIR_NAME=assets

# 素材索引文件名
ASSET_INDEX_FILENAME=index.json


# 提示词根目录
PROMPT_ROOT=./prompts

# 提示词子版本
PROMPT_VERSION=v1

# 跨agent共用提示词文件夹
PROMPT_SHARED_DIR=shared

# 模版参数缺失是否报错，不开启则渲染空值
PROMPT_STRICT_UNDEFINED=true

# 提示词缓存条目上限
PROMPT_CACHE_SIZE=64

# 校验次数上限
VERIFY_MAX_ATTEMPTS=3

# 智能体校验策略
# raise: 校验智能体的语义问题，没消除就报错
# accept_with_warning: 降级并把问题记到verification_logs
VERIFY_EXHAUSTED_POLICY=accept_with_warning


# 对应供应商的api key，配了哪个就填哪个
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
